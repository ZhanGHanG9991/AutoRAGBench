{
  "$schema": "https://opencode.ai/config.json",
  "model": "gemini/gemini-3.8-flash",
  "small_model": "gemini/gemini-3.8-flash",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "gemini": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gemini 3.8 Flash (OpenAI-compatible chat)",
      "options": {
        "baseURL": "{env:GEMINI_OPENAI_BASE_URL}",
        "apiKey": "{env:GEMINI_API_KEY}",
        "timeout": 600000
      },
      "models": {
        "gemini-3.8-flash": {
          "name": "gemini-3.8-flash",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 16384
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "external_directory": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
