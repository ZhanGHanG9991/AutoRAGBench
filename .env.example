# Copy to .env (never commit .env). llm/common.sh loads it on the host; keys reach an agent's sandbox only when
# agents/registry.json lists them for that agent's provider.

# --- optional path overrides (defaults: inside the repository; configs/pilot.env)
# RAGENG_ROOT=/path/to/AutoRAGBench          # required in the environment of `sbatch slurm/*.sbatch`
# RAGENG_DATA_VERSION=formal-v2
# SOFTWARE_DIR=/path/to/software             # Node.js for the agent CLIs: $SOFTWARE_DIR/node/bin
# SIF_IMAGE=/path/to/rageng.sif              # Singularity image (python:3.12-bookworm base)
# SANDBOX=singularity                        # singularity | bwrap | none
# PIP_MIRROR=https://pypi.org/simple
# HF_MIRROR=https://huggingface.co

# --- anti-cheating judges (Codex CLI + DeepSeek V4.1 Flash) and the DeepSeek Harness agent
DEEPSEEK_API_KEY=

# --- GPT-6.1 Sol / GPT-6 Sol / GPT-5.6 Sol / GPT-5.6 Luna + Codex CLI (OpenAI Responses API)
OPENAI_API_KEY=

# --- GLM-5.3-Flash and GLM-5.3 + Claude Code (Zhipu Anthropic-compatible endpoint)
GLM_API_KEY=
# GLM_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# --- Qwen3.8 Flash + Claude Code (needs an Anthropic-Messages-compatible endpoint serving qwen3.8-flash)
DASHSCOPE_API_KEY=
QWEN_ANTHROPIC_BASE_URL=

# --- Gemini 3.8 Flash + OpenCode (OpenAI-compatible chat endpoint)
GEMINI_API_KEY=
# GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- examples/minimal_eval.py: key of an optional OpenAI-compatible reader endpoint
# READER_API_KEY=
