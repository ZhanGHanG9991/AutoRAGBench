# The only configuration the agent sandbox sees (bound read-only as configs/sandbox/; sourced by task/self_check and
# by configs/pilot.env). It holds the shared environments, the per-question inference budget and the port layout of
# one job, and nothing about data, records, judges or the hidden store.
RAGENG_ROOT=${RAGENG_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}

# Environments (see scripts/install_envs.sh)
VLLM_PY=$RAGENG_ROOT/envs/vllm/bin/python
RAG_BASE_PY=$RAGENG_ROOT/envs/rag-base/bin/python

# Per-question inference budget
BUDGET_CALLS=4
BUDGET_TOKENS=32000
BUDGET_SECONDS=60

# Deliverable size: the frozen workspace (every file, apparent size) may not exceed this (slurm/run.sbatch)
WORKSPACE_LIMIT_GB=200

# Ports of one job, from its base RAGENG_PORT_BASE (chosen in configs/pilot.env, passed into the sandbox)
rageng_ports() {
  _PB=$RAGENG_PORT_BASE
  VLLM_PORT=$_PB
  GATEWAY_PORT=$((_PB + 1))            # build gateway (LLM_BASE_URL during build) / eval gateway
  SELFCHECK_GATEWAY_PORT=$((_PB + 2))
  SERVICE_PORT=$((_PB + 3))            # submission/start.sh during eval; self_check uses +4
  HF_FILTER_PORT=$((_PB + 6))          # scripts/hf_filter.py: the agent's HF_ENDPOINT (models only)
}
if [ -n "${RAGENG_PORT_BASE:-}" ]; then rageng_ports; fi
