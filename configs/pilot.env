# Cluster configuration, sourced by every bash entry point (login node and compute node).
# Every path defaults to a location inside the repository and can be overridden from the environment (.env.example).

RAGENG_ROOT=${RAGENG_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
# environments, per-question budget and port layout: shared with the agent sandbox (configs/sandbox/sandbox.env)
source $RAGENG_ROOT/configs/sandbox/sandbox.env
RUNS_DIR=$RAGENG_ROOT/runs
RECORDS_DIR=$RAGENG_ROOT/records
# Data version (tasks/prepare.py): data/<version>/<task>/public (corpus + train) with the test in the hidden store
# $HIDDEN_DIR/<version>/<task>/, which no sandbox ever binds (agent, self_check, service, judge). The paper uses formal-v2.
DATA_VERSION=${RAGENG_DATA_VERSION:-formal-v2}
DATA_DIR=$RAGENG_ROOT/data/$DATA_VERSION
HIDDEN_DIR=$RAGENG_ROOT/hidden

SOFTWARE_DIR=${SOFTWARE_DIR:-$RAGENG_ROOT/software}   # Node.js for the agent CLIs: $SOFTWARE_DIR/node/bin

# Isolation (scripts/sandbox.sh): singularity | bwrap | none (the paper's runs used singularity)
SANDBOX=${SANDBOX:-singularity}
SIF_IMAGE=${SIF_IMAGE:-$RAGENG_ROOT/envs/images/rageng.sif}
EVAL_NET=none            # none: the frozen service runs without network (relay over unix sockets); host: shared

# Generator: fixed, served by the evaluator, reachable only through the gateway.
GENERATOR_PATH=$RAGENG_ROOT/models/Qwen3.5-4B   # models/ may be a symlink (configs/readers.json, multireader/contract.py)
GENERATOR_NAME=generator
VLLM_GPU_UTIL=0.35
VLLM_MAX_LEN=32768
VLLM_MAX_SEQS=256       # Qwen3.5 is hybrid (Mamba cache blocks limit concurrent seqs)
# Port selection probes a job-derived block outside the kernel ephemeral range.
# Keeping service ports outside that range avoids races with outgoing TCP connections.
# One base per Slurm job, exported so every script of the job uses the same ports (the agent sandbox gets
# RAGENG_PORT_BASE explicitly). Start from the job-id slot and skip blocks already bound on the node: nodes are
# shared with other users, and a taken port made vLLM restart in a loop (eval job 667529).
# The base is reused only inside the job that chose it: sbatch copies the submitting shell's environment into the
# job, so a value exported elsewhere (login node, another job) must not be trusted.
if [ -z "${RAGENG_PORT_BASE:-}" ] || [ "${RAGENG_PORT_JOB:-}" != "${SLURM_JOB_ID:-}" ]; then
  RAGENG_PORT_BASE=$(( 10000 + (${SLURM_JOB_ID:-0} % 200) * 100 ))
  if [ -n "${SLURM_JOB_ID:-}" ] && [ -x "$VLLM_PY" ]; then
    RAGENG_PORT_BASE=$(PYTHONPATH="$RAGENG_ROOT" "$VLLM_PY" -c \
      'import sys; from multireader.ports import choose_port_base; print(choose_port_base(sys.argv[1]))' \
      "$SLURM_JOB_ID") || { echo "Cannot reserve a safe service port block" >&2; exit 2; }
  fi
  RAGENG_PORT_JOB=${SLURM_JOB_ID:-}
  if [ -n "$RAGENG_PORT_JOB" ]; then export RAGENG_PORT_BASE RAGENG_PORT_JOB; fi
fi
rageng_ports   # VLLM_PORT, GATEWAY_PORT, SELFCHECK_GATEWAY_PORT, SERVICE_PORT, HF_FILTER_PORT (sandbox.env)

# Build budget (seconds) and Slurm resources
BUILD_SECONDS=${BUILD_SECONDS:-21600}  # six hours, as in the paper
EVAL_SECONDS=${EVAL_SECONDS:-14400}    # evaluation budget of a formal run (service startup + all test questions;
                                       # evaluator.py --eval-seconds, unanswered questions score 0), not part of BUILD_SECONDS
SLURM_PARTITION=${SLURM_PARTITION:-gpu}
SLURM_CPUS=16
SLURM_MEM=128G
# Formal run jobs (slurm/run.sbatch, direct or in a gpu_pool worker): 12 CPUs so that 8 fit one 104-CPU H800 node;
# memory is not a scheduled resource here (CR_CPU) but the cgroup limit (90% usable), sized for 21M-passage corpora.
RUN_CPUS=12
RUN_MEM=240G

# Package / model mirrors for agents
PIP_MIRROR=${PIP_MIRROR:-https://pypi.org/simple}
HF_MIRROR=${HF_MIRROR:-https://huggingface.co}
